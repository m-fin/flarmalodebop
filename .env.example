# Copy the values you need into a gitignored file.
#   cp .env.example .env
# Never commit real passwords, the Supabase service_role key, the VAPID
# private key, the database URL, or the webhook secret.

# --- v1 Node server (repo root) ---
PORT=8787
DATA_DIR=./data
# Path to the chmod-600 file that setup.js writes. Keep it outside the repo.
FLARM_SECRETS=/home/you/.secrets/flarmalodebop.env

# Names written into that secrets file (values stay out of git):
# FROG_PASSWORD=
# HAILEY_PASSWORD=
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# VAPID_SUBJECT=mailto:you@example.com

# --- v2 web app and Expo ---
# Public client config. Safe to ship in the app once Row Level Security is on.
# Put these in v2/public/config.js (see v2/public/config.example.js)
# and ios-app/src/lib/config.ts.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
# VAPID_PUBLIC=

# Server-only. Set these in Supabase Edge Function secrets, never in the app.
# SUPABASE_SERVICE_ROLE_KEY=
# FLARM_WEBHOOK_SECRET=
# VAPID_PRIVATE=
# DATABASE_URL=
